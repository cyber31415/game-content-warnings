# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=8081

# Developer Console > Extensions > (your extension) > Settings
TWITCH_EXT_CLIENT_ID=
# "Client Secret" (generate under Settings). Used for the Helix app access token.
TWITCH_EXT_CLIENT_SECRET=
# "Extension Secret" key under Settings > Extension Client Configuration (base64). Signs/verifies JWTs.
TWITCH_EXT_SECRET=
# Numeric Twitch user ID of the account that owns the extension.
TWITCH_EXT_OWNER_ID=

# DoesTheDogDie API key (your DDD profile page). Server-side only, never in the frontend.
DDD_API_KEY=

DATABASE_PATH=./data/cache.sqlite
# Needed only when DATABASE_PATH is on a network share (CIFS/SMB) without byte-range locks.
DATABASE_VFS=unix-dotfile

# Defaults to https://<client id>.ext-twitch.tv. Add https://localhost:8080 for Local Test.
ALLOWED_ORIGINS=

# Live category updates. Requires the EBS on public HTTPS (port 443). Both or neither.
EVENTSUB_CALLBACK_URL=
EVENTSUB_SECRET=

# Shown on the privacy/terms pages (GitHub Pages copies are built from these by
# scripts/build-legal-pages.ts; the EBS mirrors them at /privacy and /terms). CONTACT_EMAIL is required in production.
EXT_NAME=Game Content Warnings (Unofficial)
OPERATOR_NAME=
CONTACT_EMAIL=

# Where broadcaster corrections are stored: "twitch" (developer configuration segment; default in
# production, requires "Extension Configuration Service" in the console) or "local" (SQLite only).
CORRECTIONS_STORE=
# Client-IP header set by a trusted proxy, for rate limiting (Render sits behind Cloudflare).
CLIENT_IP_HEADER=
